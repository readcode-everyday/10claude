# OpenClaw reverse proxy
# Caddy auto-provisions HTTPS certificates (Let's Encrypt or internal CA).
#
# For Tailscale-only access (no public domain):
#   - Replace ":443" with your Tailscale hostname, e.g. "my-server.tail1234.ts.net"
#   - Caddy will get a cert from Let's Encrypt via Tailscale's MagicDNS automatically
#     if you enable "HTTPS" in your Tailscale admin panel (requires tailscale funnel).
#
# For LAN-only / Tailscale-only with self-signed TLS, use "tls internal".

{
    # Global options
    admin off
}

# Bind on all interfaces — Tailscale will expose only what you enable
:443 {
    # Self-signed cert (works on LAN/Tailscale, browser will warn once on first visit)
    tls internal

    # Basic auth — password hash generated by: caddy hash-password --plaintext YOUR_PASS
    basicauth /* {
        {$UI_USER} {$UI_PASS_HASH}
    }

    reverse_proxy localhost:18888
}

# Redirect plain HTTP to HTTPS
:80 {
    redir https://{host}{uri} permanent
}
